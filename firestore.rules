rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to products, categories, and discounts
    match /products/{id} {
      allow read: if true;
      allow write: if true; // In a production app, restrict this to admin only
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /discounts/{id} {
      allow read: if true;
      allow write: if true;
    }
    // Allow public to create orders, but only admin to read them
    match /orders/{id} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }
  }
}
