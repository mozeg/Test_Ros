{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Store category for grouping products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "desc": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "hidden"] },
        "img": { "type": "string", "description": "Base64 or URL icon" }
      },
      "required": ["name", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Product for sale in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "price": { "type": "number" },
        "disc": { "type": "number" },
        "cat": { "type": "string" },
        "icon": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "hidden"] },
        "badge": { "type": "string" },
        "orders": { "type": "number" },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "type": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      },
      "required": ["name", "price", "cat", "status"]
    },
    "Discount": {
      "title": "Discount",
      "description": "Discount code / coupon",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percent", "fixed"] },
        "value": { "type": "number" },
        "expiry": { "type": "string" },
        "maxUse": { "type": "number" },
        "used": { "type": "number" },
        "note": { "type": "string" }
      },
      "required": ["code", "type", "value"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "gov": { "type": "string" },
        "address": { "type": "string" },
        "note": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["name", "phone", "gov", "address", "total", "status"]
    }
  },
  "firestore": {
    "categories": {
      "schema": "Category",
      "description": "Collection of store categories"
    },
    "products": {
      "schema": "Product",
      "description": "Collection of store products"
    },
    "discounts": {
      "schema": "Discount",
      "description": "Collection of discount coupons"
    },
    "orders": {
      "schema": "Order",
      "description": "Collection of customer orders"
    }
  }
}
